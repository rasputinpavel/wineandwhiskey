# Environment & secrets
.env
.env.local
.env.*.local

# Dependencies
node_modules/

# Python venvs
**/.venv*/

# Build outputs
.next/
dist/
build/
*.tsbuildinfo

# OS
.DS_Store

# Logs
*.log
npm-debug.log*

# Data files with sensitive info (add specific paths as needed)
data/raw/

# Playwright session
.loyverse-session.json
.flow-session*.json

# Playwright debug artifacts (FLOW_DEBUG=1, SCRAPER_HEADFUL=1, etc.)
flow-debug-*.png
flow-real-*.png

# Throwaway scratch dir for debug artifacts, probe scripts, etc.
.tmp/

# Landing zone — incoming materials (supplier catalogs, screenshots, audio).
# Temporary, not knowledge/output — never commit.
.inbox/

# Heavy binary media — keep the repo lean. Creative deliverables are HTML/PNG
# committed via the creative pipeline; raw video/audio/archives stay out.
*.mp4
*.mov
*.m4a
*.mp3
*.zip

# Creative working intermediates (montage frames, scratch renders).
**/montage_work/

# Supabase CLI temp + Next.js generated env typings.
**/supabase/.temp/
next-env.d.ts

