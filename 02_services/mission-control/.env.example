# Mission Control — environment

# Auth (cookie-based, like trendwatch)
MC_SECRET=random-32-char-secret-for-jwt-signing

# Multi-user: JSON list. `allowed` is "*" (everything) or an array mixing:
#   - section keys: 'operations' | 'analytics' | 'brand' | 'marketing' | 'sales' | 'agents' | 'knowledge' | 'tech'
#     (grants every item inside that section — preferred default)
#   - item slugs from lib/registry.ts (sales-crm, design-system, inventory, …) for granular access
# Example:
# MC_USERS=[{"login":"pavel","password":"...","allowed":"*"},{"login":"anna","password":"...","allowed":["sales","brand"]},{"login":"contractor","password":"...","allowed":["design-system"]}]
MC_USERS=

# Legacy fallback: single shared password → maps to login "admin" with full access.
# Used only when MC_USERS is empty. Remove once MC_USERS is set.
MC_PASSWORD=

# Inventory module — Supabase + Loyverse REST
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
LOYVERSE_API_TOKEN=

# Future:
# RAILWAY_API_TOKEN=
# GOOGLE_SERVICE_ACCOUNT_JSON=
